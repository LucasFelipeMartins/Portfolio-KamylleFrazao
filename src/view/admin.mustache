<!doctype html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Painel administrativo Kamylle Frazão Arquitetura." />
  <title>Painel | Kamylle Frazão Arquitetura</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,500&family=DM+Sans:wght@400;500;600;700&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>

<body class="admin-body">
  <div class="admin-layout">
    <aside class="admin-sidebar" aria-label="Navegação administrativa">
      <div class="sidebar-top"><a class="brand admin-brand" href="/"><img src="/assets/images/logo.jpg"
            alt="Monograma KF" /><span class="brand-name">Kamylle Frazão<small>Arquitetura</small></span></a><button
          class="sidebar-close" type="button" aria-label="Fechar menu">×</button></div>
      <nav class="admin-nav">
        <p>MENU PRINCIPAL</p>
        <a class="is-active" href="#dashboard" data-panel="dashboard"><span>⌂</span> Visão geral</a>
        <a href="#projetos" data-panel="projects"><span>▧</span> Projetos <b>{{projetos.length}}</b></a>
        <a href="#sobre" data-panel="about"><span>◯</span> Sobre mim</a>
        <a href="#servicos" data-panel="services"><span>◇</span> Serviços</a>
        <a href="#depoimentos" data-panel="testimonials"><span>❝</span> Depoimentos</a>
      </nav>
      <div class="sidebar-user">
        <div><strong>Kamylle Frazão</strong><small>Administradora</small></div><a href="/logout" title="Sair"
          aria-label="Sair do painel">↪</a>
      </div>
    </aside>
    <div class="admin-main-wrap">
      <header class="admin-topbar"><button class="sidebar-toggle" type="button" aria-label="Abrir menu">☰</button>
        <div class="breadcrumb"><span>Admin</span><b>/</b><strong data-breadcrumb>Visão geral</strong></div>
        <div class="topbar-actions"><a href="/" target="_blank" class="view-site">Ver site
            <span>↗</span></a><button class="notification-button" type="button"
            aria-label="Notificações">♧<i></i></button><button class="admin-user-button" type="button"><span>Kamylle <small>⌄</small></span></button>
        </div>
      </header>
      <main class="admin-main">
        <section class="admin-panel is-active" id="dashboard" data-panel-content="dashboard"
          aria-labelledby="dashboard-title">
          <div class="page-heading">
            <div>
              <p class="admin-overline">{{formattedDate}}</p>
              <h1 id="dashboard-title">Olá, Kamylle <em>✦</em></h1>
              <p>Acompanhe o que está acontecendo no seu portfólio.</p>
            </div><button class="button button-primary" type="button" data-add-project>+ Novo projeto</button>
          </div>
          <div class="stat-grid">
            <article class="stat-card"><span class="stat-icon icon-burgundy">▧</span>
              <div>
                <p>Projetos publicados</p><strong>{{projectCount}}</strong>
              </div>
            </article>
            <article class="stat-card"><span class="stat-icon icon-pink">◇</span>
              <div>
                <p>Serviços ativos</p><strong>{{serviceCount}}</strong>
              </div>
            </article>
            <article class="stat-card"><span class="stat-icon icon-sand">❝</span>
              <div>
                <p>Depoimentos</p><strong>{{testimonialCount}}</strong>
              </div>
            </article>
            <article class="stat-card"><span class="stat-icon icon-cream">◎</span>
              <div>
                <p>Mensagens novas</p><strong>3</strong><small class="trend attention">● Requer atenção</small>
              </div>
            </article>
          </div>
          <div class="dashboard-grid">
            <section class="admin-card recent-projects">
              <div class="card-heading">
                <div>
                  <h2>Projetos recentes</h2>
                  <p>Últimas alterações no portfólio</p>
                </div><button class="small-link" type="button" data-go-panel="projects">Ver todos →</button>
              </div>
              <div class="project-list">
                {{#projetos}}
                <article><img src="{{urlImagem}}" alt="Projeto {{nome}}" />
                  <div><strong>{{nome}}</strong><span>{{tipoDeProjeto}} · {{endereco.cidade}}, {{endereco.estado}}</span></div><time>Hoje,
                    10:32</time><span class="status published">Publicado</span><button class="row-more" type="button"
                    aria-label="Ações do projeto">•••</button>
                </article>
                {{/projetos}}
              </div>
            </section>
          </div>
        </section>

        <section class="admin-panel" id="projects" data-panel-content="projects" aria-labelledby="projects-admin-title">
          <div class="page-heading">
            <div>
              <p class="admin-overline">PORTFÓLIO</p>
              <h1 id="projects-admin-title">Meus projetos</h1>
              <p>Gerencie os projetos exibidos no seu site.</p>
            </div><button class="button button-primary" type="button" data-add-project>+ Adicionar projeto</button>
          </div>
          <div class="admin-toolbar">
            <div class="admin-search"><span>⌕</span><input type="search" placeholder="Buscar projetos..."
                aria-label="Buscar projetos" /></div>
            <div class="toolbar-filters"><select aria-label="Filtrar por status">
                <option>Todos os status</option>
                <option>Publicados</option>
                <option>Rascunhos</option>
              </select><button class="icon-button" type="button" aria-label="Filtrar projetos">≡</button></div>
          </div>
          <section class="admin-card table-card">
            <div class="table-wrap">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th>Projeto</th>
                    <th>Categoria</th>
                    <th>Última edição</th>
                    <th>Status</th>
                    <th><span class="sr-only">Ações</span></th>
                  </tr>
                </thead>
                <tbody>
                  {{#projetos}}
                  <tr>
                    <td>
                      <div class="table-project"><img src="{{urlImagem}}" alt="" />
                        <div><strong>{{nome}}</strong><span>{{endereco.cidade}}, {{endereco.estado}}</span></div>
                      </div>
                    </td>
                    <td>{{tipoDeProjeto}}</td>
                    <td>Hoje, 10:32</td>
                    <td><span class="status published">Publicado</span></td>
                    <td>
                      <div class="table-actions">
                        <a href="/admin/projetos/{{_id}}" data-edit-project title="Editar" type="button">✎</a>
                        <button title="Duplicar" type="button"
                          data-toast="Projeto duplicado como rascunho.">⧉</button><button title="Visualizar"
                          type="button" data-toast="Prévia do projeto aberta.">↗</button>
                          <form action="/admin/projetos/{{_id}}?_method=DELETE" method="POST" style="display:inline;">
                            <button class="delete-action" title="Excluir" type="submit" data-delete="{{nome}}">⌫</button>
                          </form>
                      </div>
                    </td>
                  </tr>
                  {{/projetos}}
                </tbody>
              </table>
            </div>
            <footer class="table-footer"><span>Mostrando <strong>{{projetos.length}}</strong> de <strong>{{projetos.length}}</strong> projetos</span>
              <div><button disabled>←</button><button
                  class="is-current">1</button><button>→</button></div>
            </footer>
          </section>
        </section>

        <section class="admin-panel" id="about" data-panel-content="about" aria-labelledby="about-admin-title">
          <form action="/admin/sobre" method="POST" enctype="multipart/form-data">
            <div class="page-heading">
              <div>
                <p class="admin-overline">INSTITUCIONAL</p>
                <h1 id="about-admin-title">Sobre mim</h1>
                <p>Edite a apresentação que aparece em seu site.</p>
              </div>
              <button class="button button-primary" type="submit" data-save="Alterações em Sobre mim foram salvas.">Salvar alterações</button>
            </div>
            <div class="editor-layout">
              <div class="admin-card editor-card" data-save-form>
                <div class="field-group">
                  <label for="about-highlight">Frase de destaque</label>
                  <input id="about-highlight" name="sobreMimTitulo" type="text" value="{{adm.sobreMimTitulo}}" /><small>Use uma frase curta e marcante para o título da seção.</small>
                </div>
                <div class="field-group">
                  <label>Texto institucional</label>
                  <div class="rich-editor">
                    <div class="editor-tools"><button type="button" title="Negrito"><b>B</b></button><button type="button" title="Itálico"><i>I</i></button><button type="button" title="Lista">☷</button><button type="button" title="Inserir link">⌁</button></div>
                    <textarea name="sobreMimTexto" rows="13">{{adm.sobreMimTexto}}</textarea>
                  </div>
                </div>
                <div class="form-save-mobile"><button class="button button-primary" type="submit">Salvar alterações</button></div>
              </div>
              <aside class="admin-card image-editor">
                <div class="card-heading">
                  <div>
                    <h2>Imagens de perfil</h2>
                    <p>Estas fotos aparecem nas seções sobre e início.</p>
                  </div>
                </div>
                
                <div class="field-group">
                  <label for="imgPrincipal">Imagem Principal (Home)</label>
                  {{#adm.imgPrincipal}}
                    <img src="{{adm.imgPrincipal}}" alt="Imagem principal atual" style="max-width: 100%; margin-bottom: 1rem;" />
                  {{/adm.imgPrincipal}}
                  <input type="file" name="imgPrincipal" id="imgPrincipal">
                  <small>JPG ou PNG · A imagem que aparece no início.</small>
                </div>

                <hr style="margin: 2rem 0; border: none; border-top: 1px solid #eee;" />

                <div class="field-group">
                  <label for="imgSecundaria">Imagem Secundária (Sobre)</label>
                  {{#adm.imgSecundaria}}
                    <img src="{{adm.imgSecundaria}}" alt="Imagem secundária atual" style="max-width: 100%; margin-bottom: 1rem;" />
                  {{/adm.imgSecundaria}}
                  <input type="file" name="imgSecundaria" id="imgSecundaria">
                  <small>JPG ou PNG · A imagem menor da seção sobre.</small>
                </div>

                <hr style="margin: 2rem 0; border: none; border-top: 1px solid #eee;" />

                <div class="field-group">
                  <label for="portfolio">Portfólio (PDF)</label>
                  {{#adm.portfolioUrl}}
                    <a href="{{adm.portfolioUrl}}" target="_blank">Ver portfolio atual</a>
                  {{/adm.portfolioUrl}}
                  <input type="file" name="portfolio" id="portfolio">
                  <small>PDF · O arquivo para download na home.</small>
                </div>
              </aside>
            </div>
          </form>
        </section>

        <section class="admin-panel" id="services" data-panel-content="services" aria-labelledby="services-admin-title">
          <div class="page-heading">
            <div>
              <p class="admin-overline">CONTEÚDO</p>
              <h1 id="services-admin-title">Serviços</h1>
              <p>Organize os serviços oferecidos no seu estúdio.</p>
            </div><button class="button button-primary" type="button" data-add-service>+ Adicionar serviço</button>
          </div>
          <div class="service-admin-list">
            {{#servicos}}
            <article class="admin-card service-admin-item"><span class="drag-handle"
                title="Arrastar para reordenar">⠿</span><span class="service-admin-icon">{{{icone}}}</span>
              <div><strong>{{nome}}</strong>
                <p>{{descricao}}</p>
              </div><span class="service-order">{{ordem}}</span>
              <div class="item-buttons">
                <a href="/admin/servicos/{{_id}}" type="button" data-edit-service>✎</a>
                <form action="/admin/servicos/{{_id}}?_method=DELETE" method="POST" style="display:inline;">
                    <button type="submit" class="delete-action" data-delete="{{nome}}">⌫</button>
                </form>
                </div>
            </article>
            {{/servicos}}
          </div>
        </section>

        <section class="admin-panel" id="testimonials" data-panel-content="testimonials"
          aria-labelledby="testimonials-admin-title">
          <div class="page-heading">
            <div>
              <p class="admin-overline">CONTEÚDO</p>
              <h1 id="testimonials-admin-title">Depoimentos</h1>
              <p>Gerencie as histórias compartilhadas por seus clientes.</p>
            </div><button class="button button-primary" type="button" data-add-testimonial>+ Novo depoimento</button>
          </div>
          <div class="testimonial-admin-grid">
            {{#depoimentos}}
            <article class="admin-card testimonial-admin-card">
              <div class="testimonial-admin-head"><span class="avatar avatar-m">{{avatar}}</span>
                <div><strong>{{nomeCliente}}</strong><small>{{projeto}}</small></div><button class="row-more"
                  type="button" data-toast="Opções do depoimento abertas.">•••</button>
              </div>
              <blockquote>“{{texto}}”</blockquote>
              <footer><span>Ordem de exibição: <b>{{ordem}}</b></span>
                <div>
                    <a href="/admin/depoimentos/{{_id}}" data-edit-testimonial type="button">Editar</a>
                    <form action="/admin/depoimentos/{{_id}}?_method=DELETE" method="POST" style="display:inline;">
                        <button class="delete-action" data-delete="depoimento de {{nomeCliente}}" type="submit">Excluir</button>
                    </form>
                </div>
              </footer>
            </article>
            {{/depoimentos}}
          </div>
        </section>

        <section class="admin-panel project-editor-panel {{#isEditingProjeto}}is-active{{/isEditingProjeto}}" data-panel-content="project-editor"
          aria-labelledby="project-form-title">
          <div class="page-heading editor-heading">
            <div><button class="back-button" type="button" data-go-panel="projects">← Voltar para projetos</button>
              <p class="admin-overline">{{#isEditingProjeto}}EDITAR PROJETO{{/isEditingProjeto}}{{^isEditingProjeto}}NOVO PROJETO{{/isEditingProjeto}}</p>
              <h1 id="project-form-title">{{#isEditingProjeto}}Editar projeto{{/isEditingProjeto}}{{^isEditingProjeto}}Adicionar projeto{{/isEditingProjeto}}</h1>
              <p>Preencha as informações que serão exibidas no portfólio.</p>
            </div>
            <div class="editor-actions"><button class="button button-secondary" type="button"
                data-toast="Projeto salvo como rascunho.">Salvar rascunho</button><button class="button button-primary"
                type="submit" form="project-form" data-save="Projeto publicado com sucesso.">{{#isEditingProjeto}}Atualizar projeto{{/isEditingProjeto}}{{^isEditingProjeto}}Publicar projeto{{/isEditingProjeto}}</button></div>
          </div>
          <form id="project-form" class="project-form" action="/admin/projetos{{#isEditingProjeto}}/{{projeto._id}}?_method=POST{{/isEditingProjeto}}" method="POST" enctype="multipart/form-data">
            <div class="admin-card project-form-main">
              <div class="field-group"><label for="project-name">Título do projeto</label><input id="project-name"
                  name="project-name" required type="text" placeholder="Ex.: Casa Horizonte" value="{{projeto.nome}}" /></div>
              <div class="form-row">
                <div class="field-group"><label for="project-category">Categoria</label><select id="project-category" name="project-category">
                    <option>Selecione uma categoria</option>
                    <option value="residencial" {{#projeto.isResidencial}}selected{{/projeto.isResidencial}}>Residencial</option>
                    <option value="interiores" {{#projeto.isInteriores}}selected{{/projeto.isInteriores}}>Interiores</option>
                    <option value="comercial" {{#projeto.isComercial}}selected{{/projeto.isComercial}}>Comercial</option>
                  </select></div>
                <div class="field-group"><label for="project-location">Localização</label><input id="project-location"
                    name="project-location" type="text" placeholder="Cidade, UF" value="{{projeto.endereco.cidade}}, {{projeto.endereco.estado}}" /></div>
              </div>
              <div class="field-group"><label for="project-description">Descrição</label><textarea
                  id="project-description" name="project-description" rows="6"
                  placeholder="Conte brevemente a história e os diferenciais deste projeto...">{{projeto.descricao}}</textarea></div>
              <div class="field-group"><label>Status de publicação</label>
                <div class="radio-group"><label><input checked name="status" type="radio" value="publicado" />
                    Publicado</label><label><input name="status" type="radio" value="rascunho" /> Rascunho</label></div>
              </div>
            </div>
            <aside class="admin-card upload-card">
              <h2>Imagem principal</h2>
              <p>Escolha uma imagem que represente bem o projeto.</p>
              <div class="upload-drop">
                  <input type="file" name="image" />
                  <span>⇧</span><strong>Arraste uma imagem aqui</strong><small>ou clique para
                  selecionar</small><button type="button" data-toast="Seleção de imagem aberta.">Selecionar
                  arquivo</button></div><small>JPG ou PNG · tamanho recomendado: 1600 × 1000 px</small>
                {{#projeto.urlImagem}}
                <img src="{{projeto.urlImagem}}" alt="Imagem atual" style="max-width: 100%; margin-top: 1rem;" />
                {{/projeto.urlImagem}}
              <div class="gallery-heading">
                <h3>Galeria</h3><button type="button" data-toast="Seleção de imagens aberta.">+ Adicionar</button>
              </div>
              <div class="empty-gallery">Nenhuma imagem adicionada.</div>
            </aside>
          </form>
        </section>

        <section class="admin-panel service-editor-panel {{#isEditingServico}}is-active{{/isEditingServico}}" data-panel-content="service-editor"
          aria-labelledby="service-form-title">
          <div class="page-heading editor-heading">
            <div><button class="back-button" type="button" data-go-panel="services">← Voltar para serviços</button>
              <p class="admin-overline">{{#isEditingServico}}EDITAR SERVIÇO{{/isEditingServico}}{{^isEditingServico}}NOVO SERVIÇO{{/isEditingServico}}</p>
              <h1 id="service-form-title">{{#isEditingServico}}Editar serviço{{/isEditingServico}}{{^isEditingServico}}Adicionar serviço{{/isEditingServico}}</h1>
              <p>Preencha as informações do serviço.</p>
            </div>
            <div class="editor-actions"><button class="button button-primary"
                type="submit" form="service-form" data-save="Serviço salvo com sucesso.">{{#isEditingServico}}Atualizar serviço{{/isEditingServico}}{{^isEditingServico}}Publicar serviço{{/isEditingServico}}</button></div>
          </div>
          <form id="service-form" class="project-form" action="/admin/servicos{{#isEditingServico}}/{{servico._id}}?_method=POST{{/isEditingServico}}" method="POST">
            <div class="admin-card project-form-main">
              <div class="field-group"><label for="servico-nome">Título do serviço</label><input id="servico-nome"
                  name="nome" required type="text" placeholder="Ex.: Projeto de Interiores" value="{{servico.nome}}" /></div>
              <div class="field-group"><label for="servico-descricao">Descrição</label><textarea
                  id="servico-descricao" name="descricao" rows="6"
                  placeholder="Descreva o serviço...">{{servico.descricao}}</textarea></div>
                <div class="field-group"><label for="servico-icone">Ícone</label><input id="servico-icone"
                    name="icone" type="text" placeholder="Ex.: ⌑" value="{{servico.icone}}" /></div>
                <div class="field-group"><label for="servico-ordem">Ordem</label><input id="servico-ordem"
                    name="ordem" type="number" placeholder="Ex.: 1" value="{{servico.ordem}}" /></div>
            </div>
          </form>
        </section>

        <section class="admin-panel testimonial-editor-panel {{#isEditingDepoimento}}is-active{{/isEditingDepoimento}}" data-panel-content="testimonial-editor"
            aria-labelledby="testimonial-form-title">
            <div class="page-heading editor-heading">
                <div><button class="back-button" type="button" data-go-panel="testimonials">← Voltar para depoimentos</button>
                <p class="admin-overline">{{#isEditingDepoimento}}EDITAR DEPOIMENTO{{/isEditingDepoimento}}{{^isEditingDepoimento}}NOVO DEPOIMENTO{{/isEditingDepoimento}}</p>
                <h1 id="testimonial-form-title">{{#isEditingDepoimento}}Editar depoimento{{/isEditingDepoimento}}{{^isEditingDepoimento}}Adicionar depoimento{{/isEditingDepoimento}}</h1>
                <p>Preencha as informações do depoimento.</p>
                </div>
                <div class="editor-actions"><button class="button button-primary"
                    type="submit" form="testimonial-form" data-save="Depoimento salvo com sucesso.">{{#isEditingDepoimento}}Atualizar depoimento{{/isEditingDepoimento}}{{^isEditingDepoimento}}Publicar depoimento{{/isEditingDepoimento}}</button></div>
            </div>
            <form id="testimonial-form" class="project-form" action="/admin/depoimentos{{#isEditingDepoimento}}/{{depoimento._id}}?_method=POST{{/isEditingDepoimento}}" method="POST">
                <div class="admin-card project-form-main">
                <div class="field-group"><label for="depoimento-nome">Nome do Cliente</label><input id="depoimento-nome"
                    name="nomeCliente" required type="text" placeholder="Ex.: João da Silva" value="{{depoimento.nomeCliente}}" /></div>
                <div class="field-group"><label for="depoimento-projeto">Projeto</label><input id="depoimento-projeto"
                    name="projeto" required type="text" placeholder="Ex.: Casa dos Sonhos" value="{{depoimento.projeto}}" /></div>
                <div class="field-group"><label for="depoimento-texto">Depoimento</label><textarea
                    id="depoimento-texto" name="texto" rows="6"
                    placeholder="Escreva o depoimento...">{{depoimento.texto}}</textarea></div>
                    <div class="field-group"><label for="depoimento-ordem">Ordem</label><input id="depoimento-ordem"
                        name="ordem" type="number" placeholder="Ex.: 1" value="{{depoimento.ordem}}" /></div>
                    <div class="field-group"><label for="depoimento-avatar">Avatar (iniciais)</label><input id="depoimento-avatar"
                        name="avatar" type="text" placeholder="Ex.: JS" value="{{depoimento.avatar}}" /></div>
                </div>
            </form>
        </section>
      </main>
    </div>
  </div>
  <dialog class="confirm-modal">
    <div class="modal-icon">!</div>
    <h2>Excluir item?</h2>
    <p>Tem certeza que deseja excluir <strong data-delete-name>este item</strong>? Esta ação não poderá ser desfeita.
    </p>
    <div><button class="button button-secondary" type="button" data-close-modal>Cancelar</button><button
        class="button button-danger" type="button" data-confirm-delete>Excluir</button></div>
  </dialog>
  <div class="toast" role="status" aria-live="polite"></div>
  <script src="/js/admin.js"></script>
</body>

</html>
