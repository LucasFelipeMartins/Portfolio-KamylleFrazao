<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Portfólio de Kamylle Frazão Arquitetura." />
    <title>Kamylle Frazão | Arquitetura</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,500&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="css/styles.css" />
  </head>
  <body>
    <header class="site-header" id="topo">
      <nav class="navbar shell" aria-label="Navegação principal">
        <a class="brand" href="#topo" aria-label="Kamylle Frazão Arquitetura - início">
          <span class="brand-mark">KF</span>
          <span class="brand-name">Kamylle Frazão<small>Arquitetura</small></span>
        </a>
        <button class="menu-toggle" type="button" aria-controls="primary-menu" aria-expanded="false">
          <span></span><span></span><span></span><span class="sr-only">Abrir menu</span>
        </button>
        <div class="nav-links" id="primary-menu">
          <a class="is-active" href="#inicio">Início</a>
          <a href="#sobre">Sobre mim</a>
          <a href="#projetos">Projetos</a>
          <a href="#experience-title">Experiência</a>
          <a href="#servicos">Serviços</a>
          <a href="#contato">Contato</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero shell" id="inicio" aria-labelledby="hero-title">
        <div class="hero-copy reveal">
          <p class="eyebrow">Arquitetura que acolhe</p>
          <h1 id="hero-title">Espaços que contam a <em>sua história.</em></h1>
          <p class="hero-text">Transformo ideias em ambientes singulares, com beleza, propósito e soluções pensadas para a forma como você vive.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="{{adm.portfolioUrl}}" download>Baixar portfólio <span aria-hidden="true">↓</span></a>
            <a class="button button-secondary" href="#contato">Falar comigo <span aria-hidden="true">↗</span></a>
          </div>
          <div class="hero-note"><span class="line"></span>Atendimento presencial e on-line</div>
        </div>
        <div class="hero-art reveal">
          <div class="arch arch-one" aria-hidden="true"></div>
          <div class="arch arch-two" aria-hidden="true"></div>
          <figure class="hero-photo">
            <img src="{{adm.imgPrincipal}}" alt="Kamylle Frazão sorrindo com flores nas mãos" />
          </figure>
          <div class="hero-stamp" aria-label="Projetos autorais">
            <span>Projetos</span><strong>autorais</strong><i>✦</i>
          </div>
        </div>
      </section>

      <section class="about section shell" id="sobre" aria-labelledby="about-title">
        <div class="about-media reveal">
          <div class="about-shape"></div>
          <img src="{{adm.imgSecundaria}}" alt="Retrato de Kamylle Frazão" />
          <span class="portrait-caption">KF<br /><small>desde 2016</small></span>
        </div>
        <div class="about-content reveal">
          <p class="eyebrow">Sobre mim</p>
          <h2 id="about-title">{{{adm.sobreMimTitulo}}}</h2>
          <div class="rich-copy">
            {{{adm.sobreMimTexto}}}
          </div>
          <div class="values-grid">
            <div><span class="value-icon">✦</span><strong>Atendimento<br />personalizado</strong></div>
            <div><span class="value-icon">⌂</span><strong>Projetos<br />autorais</strong></div>
            <div><span class="value-icon">⌘</span><strong>Soluções<br />funcionais</strong></div>
            <div><span class="value-icon">♡</span><strong>Estética e<br />bem-estar</strong></div>
          </div>
          <a class="text-link" href="#contato">Conheça mais sobre mim <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section class="projects section" id="projetos" aria-labelledby="projects-title">
        <div class="shell">
          <div class="section-heading centered reveal">
            <p class="eyebrow">Portfólio selecionado</p>
            <h2 id="projects-title">Projetos que ganham <em>vida.</em></h2>
            <p>Da primeira conversa ao último detalhe, cada ambiente é feito para ser vivido.</p>
          </div>
          <div class="project-filters reveal" role="group" aria-label="Filtrar projetos">
            <button class="filter is-active" type="button" data-filter="all">Todos</button>
            <button class="filter" type="button" data-filter="residencial">Residencial</button>
            <button class="filter" type="button" data-filter="interiores">Interiores</button>
            <button class="filter" type="button" data-filter="comercial">Comercial</button>
          </div>
          <div class="project-grid">
            {{#projetos}}
            <article class="project-card reveal" data-category="{{tipoDeProjeto}}">
              <a href="#contato" class="project-image"><img src="{{urlImagem}}" alt="imagem do projeto {{nome}}" /><span>Ver projeto <b>↗</b></span></a>
              <div class="project-info"><p>{{tipoDeProjeto}}</p><h3>{{nome}}</h3><span>{{endereco.cidade}}, {{endereco.estado}}</span><small>{{descricao}}</small></div>
            </article>
            {{/projetos}}
          </div>
          <div class="section-action reveal"><a class="button button-secondary" href="#contato">Ver todos os projetos <span aria-hidden="true">→</span></a></div>
        </div>
      </section>

      <section class="experience shell section" aria-labelledby="experience-title">
        <div class="experience-title reveal"><p class="eyebrow">Em cada detalhe</p><h2 id="experience-title">Experiência que se traduz em <em>confiança.</em></h2></div>
        <div class="metrics reveal">
          <div class="metric"><strong><span data-count="{{adm.estatisticas.anosAtuacao}}">0</span>+</strong><p>Anos de<br />atuação</p></div>
          <div class="metric"><strong><span data-count="{{adm.estatisticas.projetos}}">0</span>+</strong><p>Projetos<br />realizados</p></div>
          <div class="metric"><strong><span data-count="{{adm.estatisticas.depoimentos}}">0</span>%</strong><p>Clientes<br />satisfeitos</p></div>
          <div class="metric"><strong><span data-count="{{adm.estatisticas.servicos}}">0</span></strong><p>Menções e<br />publicações</p></div>
        </div>
      </section>

      <section class="services section" id="servicos" aria-labelledby="services-title">
        <div class="shell">
          <div class="section-heading split-heading reveal"><div><p class="eyebrow">Como posso ajudar</p><h2 id="services-title">Do desejo à <em>realização.</em></h2></div><p>Uma jornada tranquila, transparente e feita sob medida para você.</p></div>
          <div class="service-grid">
            {{#servicos}}
            <article class="service-card reveal"><span class="service-number">0{{ordem}}</span><div class="service-icon">{{{icone}}}</div><h3>{{nome}}</h3><p>{{descricao}}</p><a href="#contato" aria-label="Saber mais sobre {{nome}}">→</a></article>
            {{/servicos}}
          </div>
        </div>
      </section>

      <section class="testimonials section" aria-labelledby="testimonial-title">
        <div class="shell testimonials-layout">
          <div class="testimonial-intro reveal"><p class="eyebrow">Palavras que guardo</p><h2 id="testimonial-title">Histórias de quem <em>viveu.</em></h2><div class="slider-controls"><button class="slider-arrow" type="button" data-slide="prev" aria-label="Depoimento anterior">←</button><button class="slider-arrow" type="button" data-slide="next" aria-label="Próximo depoimento">→</button></div></div>
          <div class="testimonial-slider reveal" aria-live="polite">
            {{#depoimentos}}
            <article class="testimonial {{#isVisible}}is-visible{{/isVisible}}"><span class="quote-mark">“</span><blockquote>{{texto}}</blockquote><footer><span class="avatar">{{avatar}}</span><div><strong>{{nomeCliente}}</strong><small>{{projeto}}</small></div></footer></article>
            {{/depoimentos}}
          </div>
        </div>
      </section>

      <section class="cta shell reveal" aria-labelledby="cta-title">
        <img src="assets/images/banner.avif" alt="Ambiente arquitetônico acolhedor" />
        <div class="cta-overlay"></div>
        <div class="cta-copy"><p class="eyebrow">Vamos criar juntas?</p><h2 id="cta-title">Seu próximo capítulo começa <em>aqui.</em></h2><p>Vamos transformar o seu espaço em um lugar que faça sentido para a sua história.</p><div class="cta-actions"><a class="button button-light" href="#contato">Falar comigo <span>↗</span></a><a class="button button-ghost-light" href="#projetos">Ver projetos</a></div></div>
      </section>

      <section class="contact section shell" id="contato" aria-labelledby="contact-title">
        <div class="contact-intro reveal"><p class="eyebrow">Entre em contato</p><h2 id="contact-title">Vamos conversar sobre seu <em>projeto?</em></h2><p>Conte um pouco sobre o que você imagina. Em breve, retorno para começarmos essa jornada.</p><ul class="contact-list"><li><span>✆</span><a href="tel:+5516999999999">(16) 99999-9999</a></li><li><span>✉</span><a href="mailto:ola@kamyllefrazão.com.br">ola@kamyllefrazão.com.br</a></li><li><span>◎</span><a href="#topo">@kamyllefrazao.arq</a></li><li><span>⌖</span><span>Ribeirão Preto, SP</span></li></ul></div>
        <form class="contact-form card-surface reveal" data-contact-form>
          <div class="form-row"><label>Nome<input required name="nome" type="text" placeholder="Como você gostaria de ser chamado?" /></label><label>E-mail<input required name="email" type="email" placeholder="voce@email.com" /></label></div>
          <label>Telefone<input name="telefone" type="tel" placeholder="(00) 00000-0000" /></label>
          <label>Mensagem<textarea required name="mensagem" rows="5" placeholder="Me conte um pouco sobre o seu projeto..."></textarea></label>
          <button class="button button-primary" type="submit">Enviar mensagem <span aria-hidden="true">→</span></button>
        </form>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div><a class="brand brand-footer" href="#topo"><span class="brand-mark">KF</span><span class="brand-name">Kamylle Frazão<small>Arquitetura</small></span></a><p>Arquitetura com sensibilidade, propósito e beleza para viver melhor.</p></div>
        <div><h3>Navegação</h3><a href="#sobre">Sobre mim</a><a href="#projetos">Projetos</a><a href="#servicos">Serviços</a><a href="#contato">Contato</a></div>
        <div><h3>Serviços</h3><a href="#servicos">Arquitetura</a><a href="#servicos">Interiores</a><a href="#servicos">Acompanhamento</a><a href="#servicos">Consultoria</a></div>
        <div><h3>Inspirações</h3><p>Receba novidades e inspirações do universo da arquitetura.</p><form class="newsletter-form"><input aria-label="Seu e-mail" type="email" placeholder="Seu melhor e-mail" /><button aria-label="Inscrever-se" type="submit">→</button></form></div>
      </div>
      <div class="shell footer-bottom"><span>© 2026 Kamylle Frazão Arquitetura. Todos os direitos reservados.</span><a href="login.html">Área administrativa</a><a href="#topo">Voltar ao topo ↑</a></div>
    </footer>
    <div class="toast" role="status" aria-live="polite"></div>
    <script src="js/main.js"></script>
  </body>
</html>