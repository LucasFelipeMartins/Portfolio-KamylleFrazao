          <div class="metric"><strong><span data-count="8">0</span>+</strong><p>Anos de<br />atuação</p></div>
          <div class="metric"><strong><span data-count="120">0</span>+</strong><p>Projetos<br />realizados</p></div>
          <div class="metric"><strong><span data-count="98">0</span>%</strong><p>Clientes<br />satisfeitos</p></div>
          <div class="metric"><strong><span data-count="12">0</span></strong><p>Menções e<br />publicações</p></div>
        </div>
